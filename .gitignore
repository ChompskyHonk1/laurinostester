# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local

# local tooling / agent state — never commit
.kilo/
.kilocode/
.roo/

# QA screenshots and scratch artifacts
*-full.png
desktop-*-hero.png

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
